# Copy this file to .env before running Docker Compose.

# Backend
CHORDAI_APP_NAME=ChordAI
CHORDAI_API_PREFIX=/api/v1
CHORDAI_DATABASE_URL=sqlite:////app/data/chordai.sqlite3
CHORDAI_STORAGE_ROOT=/app/data
CHORDAI_MAX_UPLOAD_BYTES=104857600
CHORDAI_MAX_AUDIO_DURATION_SECONDS=900
CHORDAI_INTERNAL_SAMPLE_RATE=44100
CHORDAI_CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
